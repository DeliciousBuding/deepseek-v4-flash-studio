# OpenAI-compatible backend (vLLM on ROCm / MI308X). The serving stack itself
# lives in the sibling repo `deepseek-v4-flash-mi308x`; this app only consumes
# its /v1 API.

# Base URL of the OpenAI-compatible server. Both host-level URLs and URLs ending
# in /v1 are accepted; the app avoids duplicating the version path.
VLLM_BASE_URL=http://127.0.0.1:8000

# Optional bearer key. VLLM_API_KEY takes precedence over VLLM_API_KEY_FILE.
VLLM_API_KEY=
# VLLM_API_KEY_FILE=/run/secrets/vllm-api-key

# Model id to request (must match the served-model-name of the backend).
MODEL_NAME=deepseek-v4-flash

# Gradio bind address / port (ModelScope Studio overrides these).
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
# GRADIO_ROOT_PATH=/deepseek-lab

# Backend and queue safety limits.
BACKEND_CONNECT_TIMEOUT_SECONDS=10
BACKEND_REQUEST_TIMEOUT_SECONDS=900
MAX_CONTEXT_TOKENS=524288
CONTEXT_PROBE_SAFETY_TOKENS=4096
INFERENCE_CONCURRENCY_LIMIT=1
QUEUE_MAX_SIZE=32

# Optional Docker full mode (Open WebUI -> LiteLLM -> vLLM). Replace this value
# before starting Compose; docker-compose.yml intentionally has no default key.
LITELLM_MASTER_KEY=replace-with-a-long-random-key
WEBUI_AUTH=true
