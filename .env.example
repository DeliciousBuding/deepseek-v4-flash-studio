# OpenAI-compatible gateway consumed by the Studio UI. The recommended topology
# is Gradio -> LiteLLM -> vLLM; the serving stack remains in the sibling repo.

# Both host-level URLs and URLs ending in /v1 are accepted.
OPENAI_BASE_URL=http://127.0.0.1:4000/v1

# OPENAI_API_KEY takes precedence over OPENAI_API_KEY_FILE.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai-api-key

# Legacy aliases remain accepted for direct vLLM deployments.
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_API_KEY=
# VLLM_API_KEY_FILE=/run/secrets/vllm-api-key

# Model id to request (must match the served-model-name of the backend).
MODEL_NAME=deepseek-v4-flash

# Gradio bind address / port (ModelScope Studio overrides these).
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
# GRADIO_ROOT_PATH=/deepseek-lab

# Backend and queue safety limits.
BACKEND_CONNECT_TIMEOUT_SECONDS=10
BACKEND_REQUEST_TIMEOUT_SECONDS=900
MAX_CONTEXT_TOKENS=524288
CONTEXT_PROBE_SAFETY_TOKENS=4096
INFERENCE_CONCURRENCY_LIMIT=1
QUEUE_MAX_SIZE=32

# LiteLLM gateway authentication. Replace this before starting Compose.
LITELLM_MASTER_KEY=replace-with-a-long-random-key
